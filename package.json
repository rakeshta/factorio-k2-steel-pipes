{
  "name": "k2-steel-pipes",
  "version": "2.2.0",
  "description": "Steel pipes & pumps inspired by Krastorio 2.",
  "author": "RaptorTWiked",
  "license": "LGPLv3",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "copy-lang": "rm -rf locale && ts-node scripts/copy-lang.ts",
    "prep-graphics": "rm -rf graphics && ts-node scripts/prep-graphics.ts",
    "build": "rm -rf build && /bin/bash scripts/build.sh",
    "publish": "/bin/bash scripts/publish.sh",
    "read-info": "ts-node scripts/read-info.ts",
    "link": "ln -s $(pwd) ~/Library/Application\\ Support/factorio/mods/$(npm run --silent read-info \"name\")",
    "unlink": "rm ~/Library/Application\\ Support/factorio/mods/$(npm run --silent read-info \"name\")"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "ts-node": "^10.9.1",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "configparser": "^0.3.10"
  }
}
